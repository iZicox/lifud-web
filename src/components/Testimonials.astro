---
const testimonials = [
	{
		quote:
			"Texto de ejemplo de testimonio. Cliente satisfecho contando su experiencia con el producto o servicio, idealmente concreta y breve.",
		name: "Ana García",
		role: "Directora, Estudio Norte",
		initials: "AG",
	},
	{
		quote:
			"Segundo texto de ejemplo. Un par de líneas bastan para transmitir confianza: qué problema tenía el cliente y cómo lo resolviste.",
		name: "Carlos Mendoza",
		role: "Fundador, Tienda Ruby",
		initials: "CM",
	},
	{
		quote:
			"Tercer texto de ejemplo de testimonio. Puedes pedir a tus clientes reales que lo reemplacen por su propia opinión en breve.",
		name: "Lucía Ferrer",
		role: "Marketing, Grupo Ávila",
		initials: "LF",
	},
];
---

<section id="testimonios" class="bg-white py-10 sm:py-12">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<div class="mx-auto max-w-2xl text-center">
			<p class="text-sm font-semibold uppercase tracking-wider text-indigo-600">Testimonios</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
				Lo que dicen nuestros clientes
			</h2>
			<p class="mt-4 text-lg text-slate-600">
				Texto de ejemplo para introducir la sección de testimonios y dar contexto al visitante.
			</p>
		</div>

		<div class="mt-14 grid gap-8 md:grid-cols-3">
			{
				testimonials.map((item) => (
					<figure class="flex flex-col rounded-2xl border border-slate-200 p-8">
						<div class="flex gap-1 text-amber-400" aria-label="5 de 5 estrellas">
							{Array.from({ length: 5 }).map(() => (
								<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
									<path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 0 0 .95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 0 0-.36 1.12l1.07 3.29c.3.92-.75 1.69-1.54 1.12l-2.8-2.03a1 1 0 0 0-1.18 0l-2.8 2.03c-.78.57-1.83-.2-1.53-1.12l1.07-3.29a1 1 0 0 0-.36-1.12L3.98 8.72c-.78-.57-.38-1.81.6-1.81h3.45a1 1 0 0 0 .95-.69l1.07-3.29z" />
								</svg>
							))}
						</div>

						<blockquote class="mt-5 flex-1 leading-relaxed text-slate-700">
							"{item.quote}"
						</blockquote>

						<figcaption class="mt-6 flex items-center gap-3 border-t border-slate-100 pt-6">
							<span class="grid h-11 w-11 place-items-center rounded-full bg-indigo-100 text-sm font-semibold text-indigo-700">
								{item.initials}
							</span>
							<span>
								<span class="block text-sm font-semibold text-slate-900">{item.name}</span>
								<span class="block text-sm text-slate-500">{item.role}</span>
							</span>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
