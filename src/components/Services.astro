---
const services = [
	{
		title: "Diseño a medida",
		description:
			"Creamos interfaces únicas que reflejan la personalidad de tu marca. Texto de ejemplo para describir el primer servicio con un poco más de detalle.",
		icon: "M4 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5zM8 21h8M12 16v5",
	},
	{
		title: "Desarrollo rápido",
		description:
			"Sitios ligeros y optimizados que cargan en menos de un segundo. Texto de ejemplo para explicar cómo trabajamos y qué incluye el servicio.",
		icon: "M8 9l-4 3 4 3M16 9l4 3-4 3M13 5l-2 14",
	},
	{
		title: "Soporte continuo",
		description:
			"Acompañamiento después del lanzamiento, con mantenimiento y mejoras mes a mes. Texto de ejemplo para completar esta tarjeta de servicio.",
		icon: "M12 3a9 9 0 1 0 9 9M12 7v5l3 3",
	},
];
---

<section id="servicios" class="bg-white py-10 sm:py-12">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<div class="max-w-2xl">
			<p class="text-sm font-semibold uppercase tracking-wider text-indigo-600">Servicios</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
				Todo lo que necesitas en un solo lugar
			</h2>
			<p class="mt-4 text-lg text-slate-600">
				Texto de ejemplo introductorio para esta sección. Aquí puedes explicar brevemente qué ofreces
				y por qué el visitante debería seguir leyendo.
			</p>
		</div>

		<div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
			{
				services.map((service) => (
					<article class="rounded-2xl border border-slate-200 bg-slate-50 p-8 transition hover:-translate-y-1 hover:border-indigo-300 hover:bg-white hover:shadow-xl">
						<div class="grid h-12 w-12 place-items-center rounded-xl bg-indigo-600 text-white">
							<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
								<path d={service.icon} />
							</svg>
						</div>
						<h3 class="mt-6 text-xl font-semibold text-slate-900">{service.title}</h3>
						<p class="mt-3 leading-relaxed text-slate-600">{service.description}</p>
						<a href="#contacto" class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-indigo-600 hover:text-indigo-500">
							Saber más
							<span aria-hidden="true">→</span>
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>
