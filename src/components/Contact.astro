<section id="contacto" class="bg-slate-900 py-10 text-white sm:py-12">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<div class="grid gap-10 lg:grid-cols-2 lg:items-center">
			<div>
				<p class="text-sm font-semibold uppercase tracking-wider text-indigo-400">Contacto</p>
				<h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
					¿Listo para empezar? Escríbenos
				</h2>
				<p class="mt-4 max-w-xl leading-relaxed text-slate-300">
					Texto de ejemplo para la sección de contacto. Indica aquí cómo tus clientes pueden
					contactarte, cuánto tardas en responder y qué pasa después de enviar el mensaje.
				</p>

				<dl class="mt-8 space-y-3 text-slate-300">
					<div class="flex items-center gap-3">
						<dt class="sr-only">Correo</dt>
						<dd class="flex items-center gap-3">
							<span class="grid h-9 w-9 place-items-center rounded-lg bg-white/10">✉️</span>
							hola@ejemplo.com
						</dd>
					</div>
					<div class="flex items-center gap-3">
						<dt class="sr-only">Teléfono</dt>
						<dd class="flex items-center gap-3">
							<span class="grid h-9 w-9 place-items-center rounded-lg bg-white/10">📞</span>
							+34 600 000 000
						</dd>
					</div>
				</dl>
			</div>

			<form class="rounded-3xl bg-white p-6 text-slate-900 shadow-2xl sm:p-8">
				<div class="grid gap-5 sm:grid-cols-2">
					<label class="block">
						<span class="text-sm font-medium text-slate-700">Nombre</span>
						<input
							type="text"
							name="name"
							placeholder="Tu nombre"
							class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"
						/>
					</label>
					<label class="block">
						<span class="text-sm font-medium text-slate-700">Email</span>
						<input
							type="email"
							name="email"
							placeholder="tu@correo.com"
							class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"
						/>
					</label>
				</div>

				<label class="mt-5 block">
					<span class="text-sm font-medium text-slate-700">Mensaje</span>
					<textarea
						name="message"
						rows="4"
						placeholder="Escribe aquí tu mensaje de ejemplo..."
						class="mt-2 w-full resize-none rounded-xl border border-slate-300 px-4 py-2.5 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"></textarea>
				</label>

				<button
					type="submit"
					class="mt-6 w-full rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-indigo-500"
				>
					Enviar mensaje
				</button>
				<p class="mt-3 text-center text-xs text-slate-500">
					Formulario de ejemplo: aún no está conectado a ningún servicio.
				</p>
			</form>
		</div>
	</div>
</section>
