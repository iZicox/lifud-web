---
const links = [
	{ href: "#inicio", label: "Productos" },
	{ href: "#servicios", label: "Catalogo" },
	{ href: "#nosotros", label: "Noticias" },
	{ href: "#testimonios", label: "Proyectos" },
	{ href: "#contacto", label: "Contacto" },
];
---

<nav aria-label="Menú principal" class="hidden gap-1 md:flex">
	{
		links.map((link) => (
			<a
				href={link.href}
				class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
			>
				{link.label}
			</a>
		))
	}
</nav>

<!-- Menú móvil -->
<details class="relative md:hidden">
	<summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700">
		Menú
		<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
		</svg>
	</summary>
	<ul class="absolute right-0 z-50 mt-2 w-52 rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
		{
			links.map((link) => (
				<li>
					<a
						href={link.href}
						class="block rounded-lg px-3 py-2 text-sm text-slate-700 transition hover:bg-slate-100"
					>
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</details>
